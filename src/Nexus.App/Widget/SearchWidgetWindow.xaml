<Window x:Class="Nexus.App.Widget.SearchWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cv="clr-namespace:Nexus.App.Converters"
        Title="Recherche rapide NEXUS" Width="700" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True" WindowStartupLocation="Manual">
    <Window.Resources>
        <cv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <cv:NotEmptyToVisibilityConverter x:Key="NotEmpty"/>
        <Style x:Key="WidgetBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ResultRow" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" CornerRadius="6" Background="Transparent" Margin="8,1"><ContentPresenter/></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource SelectBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="Header" Height="76" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
            <Border Margin="12" CornerRadius="6" BorderThickness="1" Background="{StaticResource SurfaceBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=SearchBox}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" Margin="26,0,0,0" IsHitTestVisible="False"/>
            <TextBox x:Name="SearchBox" Style="{StaticResource WidgetBox}" Margin="52,0,60,0" VerticalAlignment="Center"
                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Text="Rechercher des fichiers et des applications…" FontSize="18" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                       Margin="54,0,0,0" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Button Content="&#xE711;" Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0"
                    Focusable="False" Command="{Binding HideWidgetCommand}" ToolTip="Masquer (Échap)"/>
        </Grid>

        <ListBox x:Name="ResultsList" Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}"
                 Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}" Background="Transparent" BorderThickness="0" Padding="0"
                 Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ItemContainerStyle="{StaticResource ResultRow}"
                 PreviewMouseRightButtonDown="Results_RightButtonDown" MouseDoubleClick="Results_DoubleClick" PreviewMouseLeftButtonUp="Results_LeftButtonUp">
            <ListBox.ContextMenu>
                <ContextMenu Closed="Menu_Closed">
                    <MenuItem Header="Ouvrir" Command="{Binding OpenCommand}"/>
                    <MenuItem Header="Ouvrir l'emplacement" Command="{Binding OpenLocationCommand}"/>
                    <Separator/>
                    <MenuItem Header="Copier le chemin" Command="{Binding CopyPathCommand}"/>
                    <MenuItem Header="Copier le fichier" Command="{Binding CopyFileCommand}"/>
                    <MenuItem Header="Ajouter ou retirer des favoris" Command="{Binding ToggleFavoriteCommand}"/>
                    <Separator/>
                    <MenuItem Header="Propriétés" Command="{Binding ShowPropertiesCommand}"/>
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="46" Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="76"/>
                            <ColumnDefinition Width="112"/>
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding Icon}" Width="20" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTip="{Binding ToolTipText}">
                            <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Directory}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="{StaticResource BorderBrush}" CornerRadius="4" Padding="5,1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Extension, Converter={StaticResource NotEmpty}}">
                            <TextBlock Text="{Binding Extension}" FontSize="11" Foreground="{StaticResource MutedBrush}" MaxWidth="44" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="{Binding ModifiedText}" FontSize="12" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <DockPanel Grid.Row="2" Margin="20,6,12,10" Visibility="{Binding ShowFooter, Converter={StaticResource BoolToVis}}">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Focusable="False" Command="{Binding ShowAllCommand}" FontFamily="Segoe UI Variable Text, Segoe UI"
                    Foreground="{StaticResource AccentTextBrush}" Content="Voir tous les résultats" Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <TextBlock DockPanel.Dock="Right" Text="Entrée : ouvrir · Ctrl+Entrée : emplacement" FontSize="12" Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0"/>
        </DockPanel>
    </Grid>
</Window>
