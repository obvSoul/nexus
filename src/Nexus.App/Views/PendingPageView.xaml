<UserControl x:Class="Nexus.App.Views.PendingPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="28,12">
        <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,16" TextWrapping="Wrap"/>
        <Border Style="{StaticResource Card}" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource WarnBrush}"/>
        </Border>
    </StackPanel>
</UserControl>
