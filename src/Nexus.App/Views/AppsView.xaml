<UserControl x:Class="Nexus.App.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,4,28,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Applications" FontSize="28" FontWeight="SemiBold"/>

        <DockPanel Grid.Row="1" Margin="0,8,0,6" LastChildFill="False">
            <ListBox ItemsSource="{Binding SortModes}" SelectedIndex="{Binding SortIndex}" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource TabItem}" Focusable="False" DockPanel.Dock="Left">
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            </ListBox>
            <Button DockPanel.Dock="Right" Content="Réanalyser" Command="{Binding AnalyzeCommand}" Style="{StaticResource ActionButton}" Margin="8,0,0,0"/>
            <CheckBox DockPanel.Dock="Right" Content="Composants système" IsChecked="{Binding ShowSystem}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="12,0"/>
            <TextBox DockPanel.Dock="Right" Style="{StaticResource SearchBox}" Width="200" Padding="8,5" ToolTip="Filtrer par nom ou éditeur"
                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"/>
        </DockPanel>

        <StackPanel Grid.Row="2" Margin="2,0,0,8">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                       Text="Sans marque : taille mesurée d'après l'index  ·  ≈ : estimation  ·  (déclaré) : valeur donnée par l'installateur  ·  Le total est toujours une estimation : des données peuvent exister ailleurs."/>
        </StackPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserSortColumns="False"
                  HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="28"
                  EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="2.2*"/>
                <DataGridTextColumn Header="Éditeur" Binding="{Binding Publisher}" Width="1.2*"/>
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="90"/>
                <DataGridTextColumn Header="Installée le" Binding="{Binding DateText}" Width="95"/>
                <DataGridTextColumn Header="Programme" Binding="{Binding ProgramText}" Width="125"/>
                <DataGridTextColumn Header="Données" Binding="{Binding DataText}" Width="85"/>
                <DataGridTextColumn Header="dont caches" Binding="{Binding CacheText}" Width="85"/>
                <DataGridTextColumn Header="Total estimé" Binding="{Binding TotalText}" Width="95"/>
                <DataGridTextColumn Header="Source" Binding="{Binding SourceText}" Width="130"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,8,0,0" MaxHeight="210">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Ouvrir l'emplacement" Command="{Binding OpenInstallCommand}" Style="{StaticResource ActionButton}" Margin="8,0,0,4"/>
                        <TextBlock Text="{Binding DetailPath}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="{Binding DetailSizes}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding SelectedFolders}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <Button DockPanel.Dock="Right" Content="&#xE8DA;" Style="{StaticResource IconButton}" ToolTip="Ouvrir l'emplacement"
                                            Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Path}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="10,0"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding DetailNotes}" Foreground="{StaticResource WarnBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
