<UserControl x:Class="Nexus.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,12,28,28">
            <TextBlock Text="Dashboard" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <UniformGrid Rows="1" Columns="5">
                <Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel>
                    <TextBlock Text="Espace utilisé" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding TotalUsed}" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="4,0"><StackPanel>
                    <TextBlock Text="Espace libre" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding TotalFree}" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="4,0"><StackPanel>
                    <TextBlock Text="Disques" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding DiskCount}" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="4,0"><StackPanel>
                    <TextBlock Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"><Run Text="Fichiers indexés"/> <Run Text="{Binding IndexState, Mode=OneWay}"/></TextBlock>
                    <TextBlock Text="{Binding IndexedFiles}" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel>
                    <TextBlock Text="Applications" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding AppCount}" FontSize="24" FontWeight="SemiBold"/></StackPanel></Border>
            </UniformGrid>
            <TextBlock Text="Disques" FontSize="16" FontWeight="SemiBold" Margin="0,24,0,8"/>
            <ItemsControl ItemsSource="{Binding Disks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}">
                                        <Run Text="{Binding UsedText, Mode=OneWay}"/> / <Run Text="{Binding TotalText, Mode=OneWay}"/> · <Run Text="{Binding FreeText, Mode=OneWay}"/> libres</TextBlock>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Format}" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"/>
                                </DockPanel>
                                <ProgressBar Style="{StaticResource DiskBar}" Value="{Binding Percent, Mode=OneWay}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Top 5 des applications les plus lourdes" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,8"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding TopApps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" Margin="0,2" TextTrimming="CharacterEllipsis"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding TopAppsNote}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Top 5 des dossiers les plus lourds" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,8"/>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding TopFolders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas" Margin="0,2" TextTrimming="CharacterEllipsis"/></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding TopFoldersNote}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Activité de l'indexeur" FontSize="16" FontWeight="SemiBold" Margin="0,16,0,8"/>
            <Border Style="{StaticResource Card}">
                <ItemsControl ItemsSource="{Binding Activity}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" Margin="0,2" TextTrimming="CharacterEllipsis"/></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
