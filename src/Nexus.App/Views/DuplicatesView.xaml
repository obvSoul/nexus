<UserControl x:Class="Nexus.App.Views.DuplicatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,4,28,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Doublons" FontSize="28" FontWeight="SemiBold"/>

        <WrapPanel Grid.Row="1" Margin="0,8,0,4">
            <ListBox ItemsSource="{Binding MinSizeLabels}" SelectedIndex="{Binding MinSizeIndex}" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource TabItem}" Focusable="False" VerticalAlignment="Center">
                <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            </ListBox>
            <CheckBox Content="Même extension" IsChecked="{Binding SameExtension}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="12,0"/>
            <CheckBox Content="Inclure les dossiers d'applications" IsChecked="{Binding IncludeApps}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"
                      ToolTip="Program Files, ProgramData, AppData. Déconseillé : les applications ont besoin de leurs copies internes. Le dossier Windows n'est jamais analysé."/>
            <Button Content="{Binding ScopeLabel}" Command="{Binding ChooseScopeCommand}" Style="{StaticResource ActionButton}" Margin="0,0,4,0" ToolTip="Limiter la recherche à un dossier"/>
            <Button Content="&#xE711;" Command="{Binding ClearScopeCommand}" Style="{StaticResource IconButton}" ToolTip="Tous les dossiers indexés" Margin="0,0,12,0"/>
            <Button Content="Rechercher" Command="{Binding StartCommand}" Style="{StaticResource ActionButton}" Margin="0,0,6,0"/>
            <Button Content="Annuler" Command="{Binding CancelCommand}" Style="{StaticResource ActionButton}" Margin="0"/>
        </WrapPanel>

        <StackPanel Grid.Row="2" Margin="2,4,0,8">
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            <ProgressBar Style="{StaticResource DiskBar}" Value="{Binding Progress, Mode=OneWay}" Height="4" Margin="0,4,0,4"/>
            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="None" RowHeight="28"
                      EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fichier" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Taille" Binding="{Binding SizeText}" Width="80"/>
                    <DataGridTextColumn Header="Copies" Binding="{Binding CountText}" Width="80"/>
                    <DataGridTextColumn Header="Récupérable" Binding="{Binding WastedText}" Width="95"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SelectedGroup.Files}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsMarked}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Supprimer cette copie"/>
                                    <Button DockPanel.Dock="Right" Content="&#xE8DA;" Style="{StaticResource IconButton}" ToolTip="Ouvrir l'emplacement"
                                            Command="{Binding DataContext.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding FullPath}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ModifiedText}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Directory}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Directory}"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Envoyer la sélection à la Corbeille…" Command="{Binding DeleteMarkedCommand}" IsEnabled="{Binding HasSelection}" Style="{StaticResource ActionButton}" Margin="0"/>
            <TextBlock Text="{Binding SelectionText}" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</UserControl>
