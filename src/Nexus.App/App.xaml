<Application x:Class="Nexus.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nexus.App.ViewModels"
             xmlns:v="clr-namespace:Nexus.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SearchPageViewModel}"><v:SearchView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:StorageViewModel}"><v:StorageView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AppsViewModel}"><v:AppsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:DuplicatesViewModel}"><v:DuplicatesView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:IndexationViewModel}"><v:IndexationView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PendingPageViewModel}"><v:PendingPageView/></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
